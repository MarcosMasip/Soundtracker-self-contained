#!/bin/sh
# Maven Wrapper startup script simplified for repository usage
MAVEN_WRAPPER_DIR="$(cd "$(dirname "$0")"; pwd -P)"
WRAPPER_JAR="$MAVEN_WRAPPER_DIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_DL_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
  mkdir -p "$MAVEN_WRAPPER_DIR/.mvn/wrapper"
  echo "Downloading Maven Wrapper jar..." >&2
  curl -fsSL -o "$WRAPPER_JAR" "$WRAPPER_DL_URL" || { echo "Failed to download Maven Wrapper" >&2; exit 1; }
fi

JAVA_EXE="$(command -v java)"
if [ -z "$JAVA_EXE" ]; then
  echo "Java not found in PATH" >&2
  exit 1
fi

exec "$JAVA_EXE" -cp "$WRAPPER_JAR" org.apache.maven.wrapper.MavenWrapperMain "$@"
